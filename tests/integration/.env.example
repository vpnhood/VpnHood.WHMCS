# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real credentials.

# Base URL of the WHMCS that runs the Partner Hub addon.
# The /modules/addons/vpnhoodpartnerhub/api.php path is appended automatically.
HUB_URL=https://your-whmcs.example.com

# Partner API credentials (created under Addons -> VpnHood! Partner Hub -> a partner).
HUB_KEY=replace-with-partner-api-key
HUB_SECRET=replace-with-partner-api-secret

# A downstream ref mapped + enabled for this partner (only needed for the provisioning run).
HUB_DOWNSTREAM_REF=vpn-monthly

# --- Optional ---
# Pass -k to curl for self-signed dev certificates.
# HUB_INSECURE=1

# Also run order + lifecycle tests. WARNING: this SPENDS PARTNER CREDIT and
# provisions a REAL key on the access server. Leave at 0 for a safe read-only run.
# HUB_RUN_PROVISION=0

# Terminate the provisioned service at the end of a provisioning run (default 1).
# HUB_TERMINATE=1
